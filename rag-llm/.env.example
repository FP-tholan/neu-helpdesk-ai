# ─── Ollama ───
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT=60
OLLAMA_MAX_RETRIES=3

# ─── Service ───
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO
SECRET_KEY=change-me-in-prod

# ─── Knowledge Base ───
KB_DIR=./data/knowledge_base

# ─── Retrieval ───
RETRIEVAL_TOP_K=5
RERANK_TOP_K=3
BM25_WEIGHT=0.6
FAISS_WEIGHT=0.4
ENABLE_FAISS=false

# ─── Agent ───
AGENT_MAX_ITERATIONS=5
AGENT_TIMEOUT_SEC=45

# ─── Memory ───
MEMORY_MAX_PER_SESSION=50
MEMORY_TOP_K=5

# ─── Router ───
ROUTER_CONFIDENCE_THRESHOLD=0.5